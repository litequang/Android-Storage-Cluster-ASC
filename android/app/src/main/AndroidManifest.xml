<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="org.asc.foundation.permission.LOCAL_ENGINE" android:protectionLevel="signature" />
    <uses-permission android:name="org.asc.foundation.permission.LOCAL_ENGINE" />
    <application android:label="ASC Foundation" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <service android:name=".EngineService" android:exported="false" android:permission="org.asc.foundation.permission.LOCAL_ENGINE" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
